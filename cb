<body>

<div id="auth-box">
  <div class="title" id="page-title">你好</div>
  <div class="card">
    <div class="row"><label>用户</label><input id="user" type="text"></div>
    <div class="row"><label>密码</label><input id="pass" type="password"></div>
    <div class="row hidden" id="repass-row"><label>重复密码</label><input id="repass" type="password"></div>
    <button class="btn-action" id="main-btn" onclick="submitAuth()">登录</button>
    <span class="link-toggle" id="toggle-btn" onclick="toggleView()">或注册</span>
  </div>
</div>

<div id="disk-box" class="card hidden">
  <div style="display:flex; justify-content:space-between; margin-bottom:15px;">
    <h2>文件列表</h2>
    <button onclick="logout()" style="padding:2px 8px;">退出</button>
  </div>
  <input type="file" id="fileInput" onchange="upload()" style="margin-bottom:15px; width:100%;">
  <ul id="fileList"></ul>
</div>

<script>
const API = 'http://localhost:3000';
let token = localStorage.getItem('token');
let isRegisterMode = false;

if(token) showDisk();

function toggleView() {
  isRegisterMode = !isRegisterMode;
  document.getElementById('page-title').innerText = isRegisterMode ? '注册' : '你好';
  document.getElementById('repass-row').classList.toggle('hidden', !isRegisterMode);
  document.getElementById('main-btn').innerText = isRegisterMode ? '注册' : '登录';
  document.getElementById('toggle-btn').innerText = isRegisterMode ? '返回登录' : '或注册';
}

async function submitAuth() {
  const u = document.getElementById('user').value, p = document.getElementById('pass').value;
  if(!u || !p) return alert('请输入账号密码');
  if(isRegisterMode && p !== document.getElementById('repass').value) return alert('密码不一致');

  const type = isRegisterMode ? 'register' : 'login';
  const res = await fetch(`${API}/${type}`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({username:u, password:p}) });
  const data = await res.json();

  if(data.token) { localStorage.setItem('token', data.token); token = data.token; showDisk(); }
  else if(isRegisterMode && res.ok) { alert('注册成功，请登录'); toggleView(); }
  else alert(data.message || data.error);
}

function logout() { localStorage.removeItem('token'); location.reload(); }

async function showDisk() {
  document.getElementById('auth-box').classList.add('hidden');
  document.getElementById('disk-box').classList.remove('hidden');
  const res = await fetch(`${API}/files`, { headers: { Authorization: `Bearer ${token}` } });
  const files = await res.json();
  document.getElementById('fileList').innerHTML = files.map(f => `<li><span>${f}</span><a onclick="downloadFile('${f}')" style="color:#fff;cursor:pointer;">下载</a></li>`).join('');
}

async function upload() {
  const file = document.getElementById('fileInput').files[0];
  if(!file) return;
  const formData = new FormData(); formData.append('file', file);
  await fetch(`${API}/upload`, { method:'POST', headers:{ Authorization:`Bearer ${token}` }, body:formData });
  document.getElementById('fileInput').value = '';
  showDisk();
}

async function downloadFile(name) {
  const res = await fetch(`${API}/download/${encodeURIComponent(name)}`, { headers: { Authorization: `Bearer ${token}` } });
  if(!res.ok) return alert('下载失败');
  const blob = await res.blob();
  const url = window.URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href = url; a.download = name;
  document.body.appendChild(a); a.click(); a.remove();
  window.URL.revokeObjectURL(url);
}
</script>
</body>
</html>
